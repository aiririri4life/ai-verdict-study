# Copy this file to .env and fill in real values. Never commit .env.

OPENROUTER_API_KEY=sk-or-v1-...
ADMIN_EXPORT_PASSWORD=choose-a-long-random-password
AI_MODEL=anthropic/claude-sonnet-4.5
CONTACT_EMAIL=you@example.com

# Optional for local dev — leave both unset and it falls back to a local
# SQLite file at data/study.db. REQUIRED on Render (or any host with an
# ephemeral filesystem) — without these, the database resets on every
# redeploy and spin-down. Get these from your Turso database's dashboard.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
